<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZeControl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand_teal</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/brand_dark</item>
    </style>
    <style name="Theme.ZeControl.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ZeControl</item>
    </style>
</resources>
