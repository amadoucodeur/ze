NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
# Web Push. Générer la paire avec : bunx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:notifications@zecontrol.vercel.app
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
# Secret aléatoire partagé uniquement avec le Cron Supabase.
NOTIFICATION_DISPATCH_SECRET=your_notification_dispatch_secret
# Valeur locale et Preview. Utiliser "production" uniquement sur le
# déploiement Vercel Production avec les clés live correspondantes.
PAYDUNYA_MODE=test
PAYDUNYA_PRINCIPAL_KEY=your_master_key
PAYDUNYA_PRIVATE_TEST_KEY=test_private_your_key
PAYDUNYA_TOKEN_TEST=your_test_token
PAYDUNYA_PUBLIC_TEST_KEY=test_public_your_key
PAYDUNYA_PRIVATE_PRODUCTION_KEY=live_private_your_key
PAYDUNYA_TOKEN_PRODUCTION=your_production_token
PAYDUNYA_PUBLIC_PRODUCTION_KEY=live_public_your_key
